# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Random API key Roblox must send (header x-api-key)
API_KEY=3d780c45f8700ae15af4d329c9b031b04c70b1b9ce6d7ea6b2839ff5ee01481b

# Post vote/status messages to this Discord channel
VOTE_CHANNEL_ID=1563927962171089052

# Optional: channel webhook URL (Integrations → Webhooks). Bypasses bot Send Messages issues.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: post to a channel with this name in each server (e.g. announcements)
# VOTE_CHANNEL_NAME=announcements

# Set to true ONLY after enabling Message Content Intent in Discord Developer Portal
# ENABLE_MESSAGE_CONTENT=true

# Render sets PORT automatically; only needed locally
# PORT=3000
